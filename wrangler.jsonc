{
  "name": "varyk-com",
  "compatibility_date": "2026-09-23",
  // Serve only on varyk.com; the dashboard toggle alone is undone by the next deploy.
  "workers_dev": false,
  // Keep preview URLs for pull request previews; the default follows workers_dev.
  "preview_urls": true,
  "routes": [
    { "pattern": "varyk.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  }
}
